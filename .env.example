# ── PulseBoard environment variables ────────────────────────────────────────
# Copy this file to .env and fill in the values before running the pipeline.
# .env is listed in .gitignore and must NEVER be committed to version control.

# PostgreSQL connection (defaults match the docker-compose.yml dev container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulseboard
DB_USER=pulse
DB_PASSWORD=pulse

# Optional: override the NHS statistics page URL
# NHS_BASE_URL=https://www.england.nhs.uk/statistics/statistical-work-areas/ae-waiting-times-and-activity/
